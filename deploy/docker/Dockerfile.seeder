# syntax=docker/dockerfile:1.6

# Seeder image: builds the viewer and ships an alpine base so the
# container has a working shell + cp + chmod for staging the binary
# onto the shared emptyDir volume. We also bake the example TwinCAT
# fixtures into the image so we don't depend on a host bind mount
# (which doesn't work when the Docker daemon is remote).

FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
ENV CGO_ENABLED=0 GOOS=linux
ARG VERSION=dev
RUN go build \
    -trimpath \
    -ldflags "-s -w -X main.version=${VERSION}" \
    -o /out/gitea-twincat-viewer \
    ./cmd/gitea-twincat-viewer

FROM alpine:3.20
RUN apk add --no-cache git curl bash
COPY --from=build /out/gitea-twincat-viewer /gitea-twincat-viewer
COPY examples/twincat /examples/twincat
COPY deploy/gitea/bootstrap.sh /usr/local/bin/bootstrap.sh
RUN chmod +x /usr/local/bin/bootstrap.sh
ENTRYPOINT ["/bin/sh", "-c"]
